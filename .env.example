# ---------------------------------------------------------------------------
# weather-arb configuration. Copy to `.env` and `set -a; source .env; set +a`
# (or export the variables) before launching `python -m weather_arb.main`.
#
# With NO Kalshi credentials the system boots in DRY-RUN mode: it ingests real
# weather + market data and fully evaluates/risk-checks orders, but journals
# them locally instead of transmitting. Provide credentials + WA_DRY_RUN=false
# to trade live.
# ---------------------------------------------------------------------------

# --- Kalshi credentials (RSA API key) --------------------------------------
# Create an API key in the Kalshi web app; download the RSA private key (PEM).
# KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000
# KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem

# Endpoints (defaults target Kalshi production). For the demo environment use:
#   https://demo-api.kalshi.co/trade-api/v2  and  wss://demo-api.kalshi.co/trade-api/ws/v2
# KALSHI_REST_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# --- Runtime ----------------------------------------------------------------
WA_DB_PATH=weather_arb.sqlite3
WA_LOG_LEVEL=INFO
# Force dry-run even with credentials present (recommended until validated):
WA_DRY_RUN=true
WA_METAR_SOURCE=aviationweather      # or: iem
WA_METAR_POLL_SECONDS=45
WA_ARB_EVAL_SECONDS=20

# 1-minute ASOS lock-in augmenter (opt-in; OFF by default). Feeds intra-hour
# spike highs the routine METAR poller misses into the Strategy-1 lock-in T_max,
# so Kalshi (NWS-CLI basis) locks the crowd-underpriced higher bucket. Only ever
# RAISES T_max; corroboration + a spike_threshold cap guard against glitches.
# IEM 1-min archive lags ~1h (adds accuracy, not latency). Enable deliberately:
WA_ENABLE_1MIN_LOCKIN=false
WA_ONEMIN_POLL_SECONDS=300
WA_ONEMIN_MIN_CONFIRM=2

# --- Strategy-1 lock-in margin (SAFETY; do not lower without re-measuring) ---
# Degrees F the observed running max must clear beyond a bucket's boundary
# before the outcome is called deterministic. 0.5 is EXACT mathematical
# certainty, not a fudge factor: Kalshi settles on the ROUNDED whole-degF NWS
# CLI high, so a bucket capped at 84 is only a sure NO once the true max reaches
# 84.5. The pre-2026-08-26 rule was effectively 0.0 (a bare `observed > cap`)
# and made 18 wrong calls in 564 replayed detections -- 14 of them on the exact
# daily_tmax values the live engine consumes. Verify with:
#   .venv/bin/python scripts/replay_lockins.py
WA_LOCKIN_MARGIN_F=0.5

# --- Strategy-1 discovery experiment (OBSERVATION ONLY; never places orders) ---
# Records lock-in detections, order-book snapshots, executable VWAPs and
# secondary-source observations so the depth/adverse-selection questions can be
# answered from data instead of prose. Read it with:
#   .venv/bin/python -m weather_arb.experiment_report --days 1 --gate0
WA_ENABLE_EXPERIMENT=true
# Control cadence for EVERY tracked market -- the null hypothesis. Without it
# you cannot tell an event-driven discount from ordinary microstructure.
WA_EXPERIMENT_CONTROL_SECONDS=600
# Faster cadence once a market is within WA_EXPERIMENT_ARM_THRESHOLD_F of its
# certainty bound, so the minutes BEFORE a detection exist (they cannot be
# sampled retroactively).
WA_EXPERIMENT_ARMED_SECONDS=60
WA_EXPERIMENT_ARM_THRESHOLD_F=3.0
WA_EXPERIMENT_TICK_SECONDS=30
# Hard cap on order-book GETs per tick. Kalshi's client-side bucket is 8/s and
# the evaluation loop already spends it; the recorder is a junior partner.
WA_EXPERIMENT_MAX_CAPTURES=12

# Secondary observation source: api.weather.gov 5-minute ASOS product. FREE, no
# key, and it leads the hourly METAR by a measured median 53 min at 5 of 7
# stations (KNYC and KDEN serve hourly only). SHADOW ONLY -- its whole-degC
# quantization (1.8 F) is coarser than the +-0.08 F METAR error that caused the
# lock-in defect, so it cannot prove certainty and is wired to no order path.
WA_ENABLE_NWS_5MIN=true
WA_NWS_5MIN_POLL_SECONDS=120

# Passive model-edge placement (opt-in; OFF by default). Strategy 2 is a taker
# today (only trades when the ask is already at/below the fee-adjusted fair price).
# With this on, when it can't take profitably it instead rests a bid below the ask
# (or an ask above the bid) to capture the spread on no-rush edge trades. May not fill.
# Per-strategy LIVE clearance. WA_DRY_RUN is global, so without this, going live
# for Strategy 1 (near-riskless lock-in) would ALSO put Strategy 2 live -- and
# Strategy 2 measures -$3.26/trade. Leave false to trade lock-ins only.
# No effect while WA_DRY_RUN=true: paper measurement of Strategy 2 continues.
WA_ALLOW_LIVE_MODEL_EDGE=false
WA_ENABLE_PASSIVE_MODEL_EDGE=false
WA_PASSIVE_IMPROVE_TICKS=1

# Probability recalibration + price floor for Strategy 2 (opt-in; OFF by default).
# Raw models are well-calibrated in aggregate but overconfident on cheap longshot
# buckets, which the edge rule over-selects. `backtest --strategy 2 --calibrate`
# gave a ~72% out-of-sample loss reduction (still net-negative -- do NOT go live yet).
# Fit + cache the curves: `backtest --strategy 2 --calibrate --persist`, then enable:
WA_ENABLE_PROBABILITY_CALIBRATION=false
WA_MODEL_EDGE_MIN_PRICE_CENTS=0    # e.g. 15 to refuse sub-15c longshot entries

# Intraday sharpening of the Strategy-2 forecast (opt-in; OFF by default). The
# static forecast scales sigma by lead time alone (~4.5F live), which smears
# probability into the cheap longshot buckets that lose money. The intraday
# remaining-rise climatology collapses that uncertainty as the day progresses --
# after peak heating the running max IS the daily max. The blended `<model>_id`
# variants are logged as shadow predictions either way (graded by Brier and by
# `backtest --strategy 2`); this flag is what makes Strategy 2 trade them. Turn it
# on only once the leaderboard says `_id` beats its base model:
WA_ENABLE_INTRADAY_FORECAST=false
# Floor on the intraday sigma (F). Really a settlement-BASIS allowance: our max
# comes from hourly METARs, Kalshi settles on the 1-minute CLI max (see
# `divergence`). Lower only with WA_ENABLE_1MIN_LOCKIN closing that gap.
WA_INTRADAY_SIGMA_FLOOR_F=1.0

# --- Risk -------------------------------------------------------------------
WA_ACCOUNT_EQUITY_USD=10000
WA_MAX_FRACTION_PER_MARKET=0.05      # 5% equity cap per ticker (Strategy 1)
WA_MAX_FRACTION_MODEL_EDGE=0.02      # tighter cap for the probabilistic Strategy 2
WA_MODEL_EDGE_THRESHOLD=0.15         # required EV edge (probability points)
# Fractional-Kelly sizing for model-edge (0 = off -> flat cap only, today's default).
# e.g. 0.25 = quarter-Kelly on the modeled edge. Downsizes within the caps below.
WA_KELLY_FRACTION=0.0
# Correlation cap: max equity fraction across all buckets of one station/day
# (they settle on one underlying). 0 = off. Recommended ~0.10 when going live.
WA_MAX_FRACTION_PER_GROUP=0.0

# Trading model for Strategy 2: "auto" (lowest Brier, default), a pinned name
# (current/nbm/gfs_mos/ensemble/climo/blend/intraday/*_bc/*_id), or "auto_pnl"
# (highest backtested net P&L from the model_pnl cache -- run `backtest
# --strategy 2 --persist` periodically to populate it; Brier != profitability).
# An "auto" pick only trades an intraday-sharpened `_id` model when
# WA_ENABLE_INTRADAY_FORECAST is on; otherwise it falls back to the base model.
# WA_TRADING_MODEL=auto
# How often to snapshot each shadow prediction into model_prediction_history
# (bounds growth; feeds the full-lead-time Strategy-2 backtest). 0 = every eval.
WA_PREDICTION_HISTORY_INTERVAL_SECONDS=1800

# --- Costs & monitoring -----------------------------------------------------
WA_KALSHI_FEE_COEFF=0.07             # est. fee coeff (fee=coeff*C*P*(1-P)); nets out of P&L
WA_HEARTBEAT_SECONDS=600             # periodic status + running net-P&L log line

# --- Alerts (watchdog + Strategy-1 lock-ins) --------------------------------
# Get phone pushes if the tracker dies, a mapping drifts, or -- since 2026-08-23 --
# a Strategy-1 LOCK-IN fires. Pick a hard-to-guess topic and subscribe to it in the
# free ntfy app (ntfy.sh). Without this, alerts still land in logs/alerts.log, but
# nothing reaches your phone: the tracker reads this from .env via run.sh, and a
# lock-in is the one event you cannot afford to find out about hours later.
# WA_NTFY_TOPIC=weatherarb-your-topic-abc123
# WA_NTFY_URL=https://ntfy.sh/weatherarb-your-topic-abc123   # (alternative: full URL / self-hosted)
WA_HEARTBEAT_STALE_MINUTES=40        # alert if no heartbeat for this long

# --- Cross-venue basis monitor (reference only; never trades) ----------------
# Scope for `python -m weather_arb.cross_venue`: "us" (Kalshi / IBKR ForecastEx /
# Polymarket-US) or "global" (adds UK/EU exchanges Betfair / Smarkets, for a
# collaborator in those regions). The CLI's --scope flag overrides this.
WA_VENUE_SCOPE=us
# WA_FORECASTEX_FEE_CENTS is not read from env; edit forecastex_fee_cents_per_contract
# in config if your IBKR commission tier differs from the ~1c/contract estimate.
# Live quote monitor (`python -m weather_arb.cross_venue_quotes`): Polymarket is
# pulled from its public Gamma API (no key). ForecastEx has NO public feed, so to
# price it you run IBKR's Client Portal Gateway locally, log in, and point the
# monitor at it. Without these it runs Polymarket-only. Read-only, never trades.
#
# 1) Gateway REST base (self-signed cert on localhost -> IBKR_VERIFY_SSL=false):
# IBKR_WEB_API_BASE=https://localhost:5000/v1/api
# IBKR_VERIFY_SSL=false
#
# 2) Tell it where a city's ForecastEx daily-high contracts are. Either paste
#    today's threshold conids (most reliable; conids roll daily):
# WA_FORECASTEX_CONTRACTS_JSON={"LAX":[[76,123456],[78,123457]],"MIA":[[90,223344]]}
#    ...or give the underlying symbol per city for auto-discovery (validate live):
# WA_FORECASTEX_SYMBOLS_JSON={"LAX":"<symbol>","MIA":"<symbol>"}

# --- Auto-discovery ---------------------------------------------------------
WA_ENABLE_DISCOVERY=true
# Map Kalshi high-temp series -> the ICAO station it settles against. VERIFY
# these against each series' official settlement rules. Only series whose
# station is also monitored (see stations) are traded.
# WA_WEATHER_SERIES_JSON={"KXHIGHNY":"KNYC","KXHIGHCHI":"KMDW"}

# --- Markets (optional manual override; discovery handles this automatically) -
# JSON array mapping tradeable tickers to their station + strike temperature (F).
# Weather tickers roll daily on Kalshi (e.g. KXHIGHCHI-25JUL21-B90.5), so update
# these each session or wire in a market-discovery step. Example:
# WA_MARKETS_JSON=[{"ticker":"KXHIGHCHI-25JUL21-B90.5","icao":"KORD","strike_temp_f":90.5,"comparison":">=","title":"Chicago high >= 90.5F"},{"ticker":"KXHIGHNY-25JUL21-B88.5","icao":"KNYC","strike_temp_f":88.5,"comparison":">=","title":"NYC high >= 88.5F"}]
